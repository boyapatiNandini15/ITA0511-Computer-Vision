import cv2
import os
import subprocess

image_path=os.path.expanduser("~/Desktop/input.jpg")
img=cv2.imread(image_path)

if img is None:
    print("Image not found!")
    exit()

cv2.putText(
    img,
    "B.NANDINI",
    (30,60),
    cv2.FONT_HERSHEY_SIMPLEX,
    1.5,
    (255,255,255),
    3
)

output_path=os.path.expanduser("~/Desktop/watermark.jpg")

cv2.imwrite(output_path,img)

print("Watermark added successfully")
print("Output:",output_path)

subprocess.run(["open",output_path])
