import cv2
import numpy as np
import os
import subprocess

image_path=os.path.expanduser("~/Desktop/input.jpg")
img=cv2.imread(image_path)

if img is None:
    print("Image not found!")
    exit()

h,w=img.shape[:2]

src=np.float32([
    [0,0],
    [w-1,0],
    [w-1,h-1],
    [0,h-1]
])

dst=np.float32([
    [50,50],
    [w-50,30],
    [w-30,h-50],
    [30,h-30]
])

M=cv2.getPerspectiveTransform(src,dst)
result=cv2.warpPerspective(img,M,(w,h))

output_path=os.path.expanduser("~/Desktop/perspective.jpg")
cv2.imwrite(output_path,result)

print("Perspective transformation completed")
print("Output:",output_path)

subprocess.run(["open",output_path])
