import cv2
import os

video_path=os.path.expanduser("~/Desktop/video.mp4")

cap=cv2.VideoCapture(video_path)

if not cap.isOpened():
    print("Video not found!")
    exit()

print("Video started")
print("Press Q to stop")

while True:
    ret,frame=cap.read()

    if not ret:
        break

    cv2.imshow("Video",frame)

    if cv2.waitKey(30)&0xff==ord("q"):
        break

cap.release()
cv2.destroyAllWindows()
print("Video completed")
