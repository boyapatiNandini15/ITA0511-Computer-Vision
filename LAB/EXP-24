import cv2
import os
import subprocess

image_path=os.path.expanduser("~/Desktop/input.jpg")
img=cv2.imread(image_path)

if img is None:
    print("Image not found!")
    exit()

blur=cv2.GaussianBlur(img,(9,9),10)
mask=cv2.subtract(img,blur)

result=cv2.addWeighted(img,2.0,mask,1.0,0)

output_path=os.path.expanduser("~/Desktop/high_boost.jpg")
cv2.imwrite(output_path,result)

print("High-boost filtering completed")
print("Output:",output_path)

subprocess.run(["open",output_path])
