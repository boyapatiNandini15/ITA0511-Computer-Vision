import cv2
import numpy as np
import os
import subprocess

image_path=os.path.expanduser("~/Desktop/input.jpg")
img=cv2.imread(image_path)

if img is None:
    print("Image not found!")
    exit()

h,w=img.shape[:2]

src=np.float32([
    [0,0],
    [w-1,0],
    [w-1,h-1],
    [0,h-1]
])

dst=np.float32([
    [50,30],
    [w-50,20],
    [w-20,h-30],
    [20,h-20]
])

H,status=cv2.findHomography(src,dst)

print("Homography Matrix:")
print(H)

result=cv2.warpPerspective(img,H,(w,h))

output_path=os.path.expanduser("~/Desktop/homography.jpg")
cv2.imwrite(output_path,result)

print("Output:",output_path)

subprocess.run(["open",output_path])
