import cv2

cap=cv2.VideoCapture(0)

if not cap.isOpened():
    print("Camera not found!")
    exit()

print("Camera started")
print("Press Q to stop")

while True:
    ret,frame=cap.read()

    if not ret:
        break

    cv2.imshow("Web Camera",frame)

    if cv2.waitKey(30)&0xff==ord("q"):
        break

cap.release()
cv2.destroyAllWindows()
print("Camera stopped")
