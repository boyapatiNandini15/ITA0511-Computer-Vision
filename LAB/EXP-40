import cv2
import os

image_path=os.path.expanduser("~/Desktop/input.jpg")

img=cv2.imread(image_path)

if img is None:
    print("Image not found!")
    exit()

clone=img.copy()
points=[]

def select_object(event,x,y,flags,param):

    if event==cv2.EVENT_LBUTTONDOWN:

        points.append((x,y))

        if len(points)==2:

            x1,y1=points[0]
            x2,y2=points[1]

            x1,x2=sorted([x1,x2])
            y1,y2=sorted([y1,y2])

            cv2.rectangle(
                clone,
                (x1,y1),
                (x2,y2),
                (0,255,0),
                2
            )

            object_img=img[y1:y2,x1:x2]

            output_path=os.path.expanduser(
                "~/Desktop/extracted_object.jpg"
            )

            cv2.imwrite(
                output_path,
                object_img
            )

            print("Object extracted successfully")
            print("Output:",output_path)

cv2.namedWindow("Select Object")

cv2.setMouseCallback(
    "Select Object",
    select_object
)

while True:

    cv2.imshow(
        "Select Object",
        clone
    )

    key=cv2.waitKey(1)&0xff

    if key==ord("q"):
        break

cv2.destroyAllWindows()
