import cv2
import numpy as np
import os
import subprocess

image_path=os.path.expanduser("~/Desktop/input.jpg")
img=cv2.imread(image_path)

if img is None:
    print("Image not found!")
    exit()

h,w=img.shape[:2]

src=np.float32([
    [0,0],
    [w-1,0],
    [0,h-1]
])

dst=np.float32([
    [0,0],
    [w-100,50],
    [50,h-1]
])

M=cv2.getAffineTransform(src,dst)

result=cv2.warpAffine(img,M,(w,h))

output_path=os.path.expanduser("~/Desktop/affine.jpg")
cv2.imwrite(output_path,result)

print("Affine transformation completed")
print("Output:",output_path)

subprocess.run(["open",output_path])
