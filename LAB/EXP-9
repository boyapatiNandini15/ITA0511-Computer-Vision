import cv2
import os
import subprocess

image_path=os.path.expanduser("~/Desktop/input.jpg")
img=cv2.imread(image_path)

if img is None:
    print("Image not found!")
    exit()

h,w=img.shape[:2]
center=(w//2,h//2)

matrix1=cv2.getRotationMatrix2D(center,-45,1)
matrix2=cv2.getRotationMatrix2D(center,45,1)

clockwise=cv2.warpAffine(img,matrix1,(w,h))
counter=cv2.warpAffine(img,matrix2,(w,h))

p1=os.path.expanduser("~/Desktop/clockwise.jpg")
p2=os.path.expanduser("~/Desktop/counter_clockwise.jpg")

cv2.imwrite(p1,clockwise)
cv2.imwrite(p2,counter)

print("Rotation completed")

subprocess.run(["open",p1])
