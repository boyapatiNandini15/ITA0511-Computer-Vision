import cv2
import os
import subprocess

image_path=os.path.expanduser("~/Desktop/input.jpg")
img=cv2.imread(image_path)

if img is None:
    print("Image not found!")
    exit()

h,w=img.shape[:2]

crop=img[
    h//4:3*h//4,
    w//4:3*w//4
].copy()

ch,cw=crop.shape[:2]

if ch<=h and cw<=w:
    img[0:ch,0:cw]=crop

output_path=os.path.expanduser("~/Desktop/copy_paste.jpg")

cv2.imwrite(output_path,img)

print("Cropping, copying and pasting completed")
print("Output:",output_path)

subprocess.run(["open",output_path])
