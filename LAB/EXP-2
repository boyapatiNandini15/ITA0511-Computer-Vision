import cv2
import os
import subprocess
image_path=os.path.expanduser("~/Desktop/input.jpg")
img=cv2.imread(image_path)
if img is None:
    print("Image not found!")
    exit()
blur=cv2.GaussianBlur(img,(7,7),0)
output_path=os.path.expanduser("~/Desktop/blur.jpg")
cv2.imwrite(output_path,blur)
print("Gaussian blur completed")
print("Output:",output_path)
subprocess.run(["open",output_path])
