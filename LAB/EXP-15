import cv2
import numpy as np
import os
import subprocess

image_path=os.path.expanduser("~/Desktop/input.jpg")
img=cv2.imread(image_path)

if img is None:
    print("Image not found!")
    exit()

h,w=img.shape[:2]

src=np.float32([
    [0,0],
    [w-1,0],
    [w-1,h-1],
    [0,h-1]
])

dst=np.float32([
    [50,30],
    [w-50,20],
    [w-20,h-30],
    [20,h-20]
])

A=[]

for (x,y),(u,v) in zip(src,dst):

    A.append([-x,-y,-1,0,0,0,u*x,u*y,u])
    A.append([0,0,0,-x,-y,-1,v*x,v*y,v])

A=np.array(A)

U,S,V=np.linalg.svd(A)

H=V[-1].reshape(3,3)
H=H/H[2,2]

print("DLT Matrix:")
print(H)

result=cv2.warpPerspective(img,H,(w,h))

output_path=os.path.expanduser("~/Desktop/dlt.jpg")
cv2.imwrite(output_path,result)

print("DLT completed")
print("Output:",output_path)

subprocess.run(["open",output_path])
