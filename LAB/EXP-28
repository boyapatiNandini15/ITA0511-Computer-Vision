import cv2
import numpy as np
import os
import subprocess

image_path=os.path.expanduser("~/Desktop/input.jpg")
img=cv2.imread(image_path)

if img is None:
    print("Image not found!")
    exit()

gray=cv2.cvtColor(img,cv2.COLOR_BGR2GRAY)

kernel=np.array([
    [-1,-1,-1],
    [-1,8,-1],
    [-1,-1,-1]
])

result=cv2.filter2D(gray,-1,kernel)

output_path=os.path.expanduser("~/Desktop/boundary.jpg")

cv2.imwrite(output_path,result)

print("Boundary detection completed")
print("Output:",output_path)

subprocess.run(["open",output_path])
